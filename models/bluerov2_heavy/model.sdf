<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.11">
  <model name="bluerov2_heavy">
    <pose>0 0 0 0 0 0</pose>

    <!-- BlueROV2 thruster reference: http://www.ardusub.com/introduction/features.html -->

    <link name="base_link">
      <inertial>
        <pose>0.0 0.0 0.011 0 0 0</pose>
        <mass>13.0</mass>
        <inertia>
          <ixx>0.26</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.23</iyy>
          <iyz>0</iyz>
          <izz>0.37</izz>
        </inertia>
        <!-- Added mass M_A (von Benzon et al. 2022), about the link origin.
             Handled implicitly by the physics engine: the Hydrodynamics
             plugin's explicit added-mass term diverges when M_A > m (heave
             here: 18.68 kg vs 13 kg), so it is disabled there. -->
        <fluid_added_mass>
          <xx>6.36</xx> <xy>0</xy> <xz>0</xz> <xp>0</xp> <xq>0</xq> <xr>0</xr>
          <yy>7.12</yy> <yz>0</yz> <yp>0</yp> <yq>0</yq> <yr>0</yr>
          <zz>18.68</zz> <zp>0</zp> <zq>0</zq> <zr>0</zr>
          <pp>0.189</pp> <pq>0</pq> <pr>0</pr>
          <qq>0.135</qq> <qr>0</qr>
          <rr>0.222</rr>
        </fluid_added_mass>
      </inertial>

      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>model://bluerov2_heavy/meshes/bluerov2_heavy.dae</uri>
            <scale>0.025 0.025 0.025</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- Collision volume * fluid_density == displaced mass, used by BuoyancyPlugin -->
      <collision name="base_link_collision">
        <pose>0.0 0.0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.457 0.575 0.05</size>
          </box>
        </geometry>
      </collision>

      <!-- Full-size hull (0.457 x 0.575 x 0.254 m, matching the visual mesh)
           for contacts, so the vehicle can't sail through gates and posts.
           It is a MESH on purpose: graded buoyancy (used by every world this
           model runs in) skips mesh collisions, so the thin box above stays
           the only buoyancy volume and the trim is unchanged. A box here
           would add ~53 kg of lift. -->
      <collision name="hull_collision">
        <pose>0.0 0.0 0.036 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2_heavy/meshes/hull_box.stl</uri>
            <scale>0.457 0.575 0.254</scale>
          </mesh>
        </geometry>
      </collision>

      <!-- IMU sensor gyro and accel data will be sent to ArduSub -->
      <sensor name="imu_sensor" type="imu">
        <!-- Transform from the Gazebo body frame (x-forward, y-left, z-up)
             to the ArduPilot body frame (x-forward, y-right, z-down) -->
        <pose>0 0 0 3.142 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>

      <!-- Forward-facing stereo pair, 0.06m baseline centered on the bow -->
      <sensor name="front_camera_left" type="camera">
        <pose>0.25 0.03 0.05 0 0 0</pose>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>front_camera/left/image_raw</topic>
      </sensor>

      <sensor name="front_camera_right" type="camera">
        <pose>0.25 -0.03 0.05 0 0 0</pose>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>front_camera/right/image_raw</topic>
      </sensor>

      <!-- RGB-D sensor co-located with the stereo pair, purely for a simulated
           raw point cloud (Gazebo can't derive depth from the stereo pair itself);
           publishes sim/front_camera/{image,depth_image,points,camera_info}.
           gz_frame_id names the optical frame so ROS consumers (rtabmap
           visual odometry) can resolve it via a static base_link TF. -->
      <sensor name="front_camera_depth" type="rgbd_camera">
        <gz_frame_id>front_camera_depth_optical</gz_frame_id>
        <!-- pitched 25 deg down: the pool floor fills the lower ~2/3 of the
             view for visual odometry (level, it mostly saw open water), while
             the top edge stays ~2 deg above horizontal so obstacles at the
             AUV's own height are still in view for obstacle avoidance
             (mira_sim obstacle_distance.py). Keep in sync with
             dnt_simulator/launch/bridge.launch.py MOUNTS. -->
        <pose>0.25 0 0.05 0 0.4363 0</pose>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <depth_camera>
            <output>depths</output>
          </depth_camera>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>sim/front_camera</topic>
      </sensor>

      <!-- Ground-truth 2D boxes for objects tagged by the Label system, for
           mira2_vision's gazebo_boxes detector (a YOLO stand-in in simulation).
           Pose, FOV, resolution and rate must match front_camera_depth so the
           boxes line up with its RGB image; publishes sim/front_camera/boxes. -->
      <sensor name="front_camera_boxes" type="boundingbox_camera">
        <gz_frame_id>front_camera_depth_optical</gz_frame_id>
        <pose>0.25 0 0.05 0 0.4363 0</pose>
        <camera>
          <box_type>2d</box_type>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>sim/front_camera/boxes</topic>
      </sensor>

      <!-- Downward-facing (bottom) camera -->
      <sensor name="bottom_camera" type="camera">
        <pose>0 0 -0.05 0 1.5707963268 0</pose>
        <!-- ROS optical frame (static TF in dnt_simulator/launch/bridge.launch.py) for optical flow -->
        <gz_frame_id>bottom_camera_optical</gz_frame_id>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>bottom_camera</topic>
      </sensor>

    </link>

    <!-- Hydrodynamics plugin -->
    <plugin
        filename="gz-sim-hydrodynamics-system"
        name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1000.0</water_density>
      <!-- Coefficients from von Benzon et al. 2022, "An Open-Source Benchmark
           Simulator: Control of a BlueROV2 Underwater Robot", JMSE 10(12) 1898.
           Gazebo uses stability-derivative signs (negative = opposing motion). -->
      <!-- Added mass is applied via <fluid_added_mass> on base_link; the
           values below are kept only for the added-mass Coriolis term C_A. -->
      <disable_added_mass>true</disable_added_mass>
      <!-- Added mass: -->
      <xDotU>-6.36</xDotU>
      <yDotV>-7.12</yDotV>
      <zDotW>-18.68</zDotW>
      <kDotP>-0.189</kDotP>
      <mDotQ>-0.135</mDotQ>
      <nDotR>-0.222</nDotR>
      <!-- First order stability derivative: -->
      <xU>-13.7</xU>
      <yV>0</yV>
      <zW>-33</zW>
      <kP>0</kP>
      <mQ>-0.8</mQ>
      <nR>0</nR>
      <!-- Second order stability derivative: -->
      <xUabsU>-141</xUabsU>
      <yVabsV>-217</yVabsV>
      <zWabsW>-190</zWabsW>
      <kPabsP>-1.19</kPabsP>
      <mQabsQ>-0.47</mQabsQ>
      <nRabsR>-1.5</nRabsR>
    </plugin>

    <link name="thruster1">
      <pose>0.14 -0.092 0.0 -1.571 1.571 -0.785</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2_heavy/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster2">
      <pose>0.14 0.092 0.0 -1.571 1.571 -2.356</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2_heavy/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster3">
      <pose>-0.14 -0.092 0.0 -1.571 1.571 0.785</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.571 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster4">
      <pose>-0.14 0.092 0.0 -1.571 1.571 2.356</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.571 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster5">
      <pose>0.118 -0.215 0.064 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 1.571</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2_heavy/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster6">
      <pose>0.118 0.215 0.064 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.571 0 1.571</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster7">
      <pose>-0.118 -0.215 0.064 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.571 0 1.571</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
